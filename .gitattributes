# Godot source should be LF everywhere; without this, Windows checkouts
# rewrite every .gd/.tscn line ending and produce whole-file diffs.
* text=auto eol=lf

*.gd text eol=lf
*.tscn text eol=lf
*.godot text eol=lf
*.import text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.svg text eol=lf

# Godot's imported resource cache is binary.
.godot/** binary
.import/** binary
