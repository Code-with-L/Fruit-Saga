; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Fruit Saga"
config/description="A Suika-style fruit merge game with combos, abilities and a daily challenge."
config/version="0.1.0"
config/icon="res://icon.png"
run/main_scene="res://scenes/ui/TitleScreen.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

GameManager="*res://autoloads/GameManager.gd"
FruitDatabase="*res://autoloads/FruitDatabase.gd"
FruitArt="*res://autoloads/FruitArt.gd"
FruitPool="*res://autoloads/FruitPool.gd"
MergeManager="*res://autoloads/MergeManager.gd"
GameFX="*res://autoloads/GameFX.gd"
Sfx="*res://autoloads/Sfx.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[layer_names]

2d_physics/layer_1="walls"
2d_physics/layer_2="fruits"

[rendering]

renderer/rendering_method="mobile"
