# Godot 4 editor cache and imported resources
.godot/
.import/

# Android build template (generated, very large)
/android/

# Signing material and export credentials must never be committed.
# export_presets.cfg itself IS committed: it contains no keystore path or
# password, since debug builds pull the keystore from the editor's own
# settings (Editor Settings > Export > Android > Debug Keystore).
*.keystore
export_credentials.cfg

# Export output
build/
*.apk
*.aab
*.idsig

# Translation imports
*.translation

# OS cruft
.DS_Store
Thumbs.db
